# ===========================================
# CODEBOT ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values

# -------------------------------------------
# SUPABASE (Required)
# Get from: https://supabase.com/dashboard/project/_/settings/api
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------
# APP URL (Required)
# -------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:9999

# -------------------------------------------
# GITHUB OAUTH (Required for repo access)
# Create at: https://github.com/settings/developers → OAuth Apps
# -------------------------------------------
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# -------------------------------------------
# GITHUB WEBHOOK (Required for change detection)
# Generate: openssl rand -hex 32
# -------------------------------------------
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# -------------------------------------------
# ENCRYPTION (Required)
# Generate: openssl rand -hex 32
# Used to encrypt stored API keys
# -------------------------------------------
ENCRYPTION_KEY=your-64-char-hex-string

# -------------------------------------------
# SLACK (Optional - add when ready)
# Create at: https://api.slack.com/apps
# -------------------------------------------
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=your-signing-secret

# -------------------------------------------
# TELEGRAM (Optional - add when ready)
# Get from: @BotFather on Telegram
# -------------------------------------------
# TELEGRAM_BOT_TOKEN=123456789:ABC-xxxxxxxxxxxxxxxxxxxxx
